{
  "manifest_version": 3,
  "name": "CN Product Extractor",
  "version": "2.0.0",
  "description": "Extract JD / Tmall product detail and Taobao search list data into StandardProduct-compatible JSONL.",
  "permissions": ["activeTab", "scripting", "storage", "tabs", "unlimitedStorage"],
  "host_permissions": [
    "https://item.jd.com/*",
    "https://item.jkcsjd.com/*",
    "https://item.yiyaojd.com/*",
    "https://item.jingxi.com/*",
    "https://*.jd.com/*",
    "https://api.m.jd.com/*",
    "https://club.jd.com/*",
    "https://www.jd.com/*",
    "https://passport.jd.com/*",
    "https://aq.jd.com/*",
    "https://*.360buyimg.com/*",
    "https://vod.jd.com/*",
    "https://s.taobao.com/*",
    "https://*.taobao.com/*",
    "https://*.tmall.com/*",
    "https://*.alicdn.com/*"
  ],
  "action": {
    "default_title": "Extract CN Product",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://s.taobao.com/search*"],
      "js": [
        "src/jd-page-url.js",
        "src/taobao-risk.js",
        "src/human-scroll.js",
        "src/human-mouse.js",
        "src/taobao-search-extractor.js",
        "src/download.js",
        "src/taobao-search-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://detail.tmall.com/item.htm*"],
      "js": [
        "src/jd-page-url.js",
        "src/tmall-extractor.js",
        "src/download.js",
        "src/tmall-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://item.jd.com/*.html*",
        "https://item.jkcsjd.com/*.html*",
        "https://item.yiyaojd.com/*.html*",
        "https://item.jingxi.com/*.html*"
      ],
      "js": [
        "src/jd-page-url.js",
        "src/human-scroll.js",
        "src/extractor.js",
        "src/download.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
